#!/bin/bash
set -euo pipefail

have() {
  command -v "$1" >/dev/null 2>&1
}

install_curl_if_missing() {
  if have curl; then
    return 0
  fi
  if have apt-get; then
    apt-get update
    apt-get install -y curl ca-certificates
    return 0
  fi
  if have apk; then
    apk add --no-cache curl ca-certificates
    return 0
  fi
  if have dnf; then
    dnf install -y curl ca-certificates
    return 0
  fi
  if have yum; then
    yum install -y curl ca-certificates
    return 0
  fi
  echo "No supported package manager found to install curl." >&2
  return 1
}

install_build_toolchain_if_missing() {
  if have cc; then
    return 0
  fi
  if have apt-get; then
    apt-get update
    apt-get install -y build-essential pkg-config libssl-dev
    return 0
  fi
  if have apk; then
    apk add --no-cache build-base pkgconfig openssl-dev
    return 0
  fi
  if have dnf; then
    dnf install -y gcc gcc-c++ make pkgconfig openssl-devel
    return 0
  fi
  if have yum; then
    yum install -y gcc gcc-c++ make pkgconfig openssl-devel
    return 0
  fi
  echo "No supported package manager found to install build toolchain." >&2
  return 1
}

install_uv_if_missing() {
  if have uv; then
    return 0
  fi
  curl -LsSf https://astral.sh/uv/install.sh | sh
}

install_rust_if_missing() {
  if have cargo; then
    return 0
  fi
  curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal
}

install_cursor_agent_if_missing() {
  if have cursor-agent; then
    return 0
  fi
  curl https://cursor.com/install -fsS | bash
}

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

mkdir -p /opt/malvin
tar -xzf /installed-agent/malvin.tar.gz -C /opt/malvin
install_curl_if_missing
install_uv_if_missing
install_build_toolchain_if_missing
install_rust_if_missing
install_cursor_agent_if_missing

# Prefer Python 3.13 for Malvin runtime across diverse task base images.
uv python install 3.13
uv venv --python 3.13 --seed /opt/malvin-venv
/opt/malvin-venv/bin/python -m pip install --upgrade pip setuptools wheel
/opt/malvin-venv/bin/python -m pip install -r /opt/malvin/requirements-harbor.txt
/opt/malvin-venv/bin/python -m pip install -e /opt/malvin

if ! have kiss; then
  cargo install --locked kiss-ai
fi
ln -sf "$HOME/.cargo/bin/kiss" /usr/local/bin/kiss || true

cp /installed-agent/malvin.tar.gz.metadata.json /logs/agent/bundle-metadata.json

python3 --version || true
/opt/malvin-venv/bin/python --version
cursor-agent --version

echo "INSTALL SUCCESS!"
